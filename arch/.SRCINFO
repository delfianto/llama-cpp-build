pkgname = ggml-znver5
	pkgdesc = Upstream ggml + CPU backend (v1.0.0) for Ryzen 9950X
	depends = gcc-libs
	depends = glibc
	optdepends = ggml-cuda-znver5: RTX 3000+ CUDA GPU backend
	provides = ggml
	provides = ggml-cpu
	provides = libggml.so
	provides = libggml-base.so
	conflicts = ggml
	conflicts = ggml-cpu
	conflicts = libggml

pkgname = ggml-cuda-znver5
	pkgdesc = Upstream ggml RTX 3000+ CUDA backend (v1.0.0, SM 86/89/120+) for Ryzen 9950X
	depends = ggml-znver5
	depends = cuda
	depends = gcc-libs
	depends = glibc
	depends = nccl
	provides = ggml-cuda
	conflicts = ggml-cuda

pkgname = llama.cpp-cuda-git
	pkgdesc = Upstream llama.cpp v1.0.0 for Ryzen 9950X, including multimodal tools
	depends = ggml-znver5
	depends = gcc-libs
	depends = glibc
	depends = openssl
	optdepends = ggml-cuda-znver5: RTX 3000+ CUDA GPU backend
	optdepends = ffmpeg: video input in multimodal tools
	provides = llama.cpp
	provides = llama-cpp
	provides = libllama.so
	conflicts = llama.cpp
	conflicts = llama.cpp-cuda
	conflicts = llama-cpp
	conflicts = llama-cpp-git
	backup = etc/conf.d/llama.cpp
