pkgbase = llama.cpp-cuda-git
	pkgdesc = Upstream llama.cpp v1.0.0 split packages for Ryzen 9950X and RTX 3000+ CUDA (SM 86/89/120+)
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/ggml-org/llama.cpp
	arch = x86_64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = ninja
	makedepends = cuda
	makedepends = nccl
	makedepends = openssl
	options = !buildflags
	options = !lto
	options = !debug
	source = llama.cpp-git::git+https://github.com/ggml-org/llama.cpp.git#tag=v1.0.0
	source = build-config.sh
	source = llama.cpp.conf
	source = llama.cpp.service
